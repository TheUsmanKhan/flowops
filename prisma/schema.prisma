// FlowOps — Multi-tenant SaaS ERP schema (Sprint 1)
// Adapted from the Supabase/PostgreSQL spec to Prisma + SQLite.
// Multi-tenant isolation is enforced in the application layer
// (company-scoping + permission checks) mirroring the RLS design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Extends the auth identity. One row per registered user.
model Profile {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  passwordHash String
  avatarUrl    String?
  phone        String?
  isOnboarded  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedOrgs         Organization[]  @relation("OrgOwner")
  createdCompanies  Company[]       @relation("CompanyCreator")
  employees         Employee[]
  settings          UserSetting?
  invitationsSent   Invitation[]    @relation("InvitedBy")
  invitationsAccepted Invitation[]  @relation("AcceptedBy")
  terminationsDone  Employee[]      @relation("TerminatedBy")
  employeeInvitedBy Employee[]      @relation("EmployeeInvitedBy")
  auditLogs         AuditLog[]
  rolesCreated      Role[]          @relation("RoleCreator")
}

/// Top-level tenant. A holding umbrella for one or more companies.
model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  logoUrl            String?
  ownerId            String
  owner              Profile  @relation("OrgOwner", fields: [ownerId], references: [id])
  subscriptionPlan   String   @default("free") // free | starter | growth | enterprise
  subscriptionStatus String   @default("active") // active | past_due | cancelled | trialing
  isActive           Boolean  @default(true)
  metadata           String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companies   Company[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  // Sprint 3 back-relations
  orgCategories        OrgCategory[]
  orgBrands            OrgBrand[]
  orgAttributes        OrgAttribute[]
  orgAttributeValues   OrgAttributeValue[]
  orgProducts          OrgProduct[]
  orgProductVariants   OrgProductVariant[]
  orgProductImages     OrgProductImage[]
  orgProductBundles    OrgProductBundle[]
  selectiveAccess      SelectiveProductAccess[]
  companyProductSettings CompanyProductSetting[]
  companyVariantPricing  CompanyVariantPricing[]
  returnedStitchedInventory ReturnedStitchedInventory[]
  productFulfillmentCosts  ProductFulfillmentCost[]

  // Sprint 6 back-relations
  inventoryLocations   InventoryLocation[]
  suppliers            Supplier[]
  inventoryPools       InventoryPool[]
  inventoryTransactions InventoryTransaction[]
  avgCostHistory       AvgCostHistory[]
  stockTransfers       StockTransfer[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseOrderReceipts PurchaseOrderReceipt[]
  supplierReturns      SupplierReturn[]
  stockLossRecords     StockLossRecord[]
  cycleCounts          CycleCount[]
  cycleCountItems      CycleCountItem[]
  productionOrders     ProductionOrder[]
}

/// Legal operating entity under an Organization. All business data lives here.
model Company {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  legalName         String?
  slug              String   @unique
  logoUrl           String?
  baseCurrency      String   @default("PKR")
  countryCode       String   @default("PK")
  taxId             String?
  taxIdType         String? // NTN | STRN
  addressStreet     String?
  addressCity       String?
  addressProvince   String?
  addressPostalCode String?
  addressCountry    String?
  phone             String?
  email             String?
  website           String?
  timezone          String   @default("Asia/Karachi")
  fiscalYearStart   Int      @default(1)
  isActive          Boolean  @default(true)
  metadata          String   @default("{}")
  createdById       String
  createdBy         Profile  @relation("CompanyCreator", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  roles            Role[]
  employees        Employee[]
  invitations      Invitation[]
  rolePermissions  RolePermission[]
  auditLogs        AuditLog[]
  metricEvents     MetricEvent[]
  activeForSettings UserSetting[]

  // Sprint 3 back-relations
  sourceProducts          OrgProduct[]
  selectiveProductAccess  SelectiveProductAccess[]
  companyProductSettings  CompanyProductSetting[]
  companyVariantPricing   CompanyVariantPricing[]
  returnedStitchedInventory ReturnedStitchedInventory[]
  productFulfillmentCosts  ProductFulfillmentCost[]

  // Sprint 6 back-relations
  inventoryLocations      InventoryLocation[]
  suppliers               Supplier[]
  inventoryTxnsCompany    InventoryTransaction[]
  purchaseOrders          PurchaseOrder[]
  supplierReturns         SupplierReturn[]
  stockLossRecords        StockLossRecord[]
  cycleCounts             CycleCount[]
  productionOrders        ProductionOrder[]
}

/// Company-scoped roles. System roles (Owner/Founder/Co-Founder/Investor) are
/// elevated and bypass all permission checks. Custom roles use role_permissions.
model Role {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  roleTier      String   @default("standard") // elevated | standard
  isSystemRole  Boolean  @default(false)
  systemRoleKey String?  // owner | founder | co_founder | investor | null
  // NOTE: systemRoleKey is unique PER COMPANY (not globally), so every
  // company can seed its own owner/founder/co_founder/investor roles.
  isActive      Boolean  @default(true)
  createdById   String?
  createdBy     Profile? @relation("RoleCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employees       Employee[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([companyId, name])
  @@unique([companyId, systemRoleKey])
}

/// Permission keys attached to standard roles. Elevated roles bypass this.
model RolePermission {
  id            String   @id @default(cuid())
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissionKey String
  createdAt     DateTime @default(now())

  @@unique([roleId, permissionKey])
}

/// Core of the Employment System. Merges HR + system access.
/// One user can have multiple employee records (one per company).
model Employee {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId            String
  user              Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId            String
  role              Role      @relation(fields: [roleId], references: [id])
  employeeCode      String?
  department        String?
  designation       String?
  directManagerId   String?
  directManager     Employee? @relation("EmployeeManager", fields: [directManagerId], references: [id])
  subordinates      Employee[] @relation("EmployeeManager")
  status            String    @default("active") // active | suspended | terminated | on_leave
  joinedAt          DateTime  @default(now())
  terminatedAt      DateTime?
  terminatedById    String?
  terminatedBy      Profile?  @relation("TerminatedBy", fields: [terminatedById], references: [id])
  terminationReason String?
  invitedById       String?
  invitedBy         Profile?  @relation("EmployeeInvitedBy", fields: [invitedById], references: [id])
  metadata          String    @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  auditLogs AuditLog[]

  // Sprint 3 back-relations (named to avoid ambiguity)
  createdCategories      OrgCategory[]      @relation("CategoryCreator")
  createdBrands          OrgBrand[]         @relation("BrandCreator")
  createdAttributes      OrgAttribute[]     @relation("AttributeCreator")
  createdProducts        OrgProduct[]      @relation("ProductCreator")
  promotedProducts       OrgProduct[]      @relation("ProductPromoter")
  demotedProducts        OrgProduct[]      @relation("ProductDemoter")
  createdVariants        OrgProductVariant[] @relation("VariantCreator")
  uploadedProductImages  OrgProductImage[] @relation("ImageUploader")
  grantedSelectiveAccess SelectiveProductAccess[] @relation("SelectiveAccessGranter")
  subscribedProducts     CompanyProductSetting[] @relation("SubscriptionCreator")
  revokedSubscriptions   CompanyProductSetting[] @relation("SubscriptionRevoker")
  receivedReturnedItems  ReturnedStitchedInventory[] @relation("ReturnedItemReceiver")
  writtenOffReturnedItems ReturnedStitchedInventory[] @relation("ReturnedItemWriteOff")
  loggedFulfillmentCosts ProductFulfillmentCost[] @relation("FulfillmentCostLogger")

  // Sprint 6 back-relations
  createdLocations       InventoryLocation[] @relation("LocationCreator")
  createdSuppliers       Supplier[] @relation("SupplierCreator")
  inventoryTxnEmployee   InventoryTransaction[] @relation("InventoryTxnEmployee")
  transferInitiator      StockTransfer[] @relation("TransferInitiator")
  poCreator              PurchaseOrder[] @relation("POCreator")
  poCanceller            PurchaseOrder[] @relation("POCanceller")
  poReceiver             PurchaseOrderReceipt[] @relation("POReceiver")
  supplierReturnReporter SupplierReturn[] @relation("SupplierReturnReporter")
  supplierReturnResolver SupplierReturn[] @relation("SupplierReturnResolver")
  stockLossReporter      StockLossRecord[] @relation("StockLossReporter")
  stockLossApprover      StockLossRecord[] @relation("StockLossApprover")
  stockLossResolver      StockLossRecord[] @relation("StockLossResolver")
  cycleCountAssignee     CycleCount[] @relation("CycleCountAssignee")
  cycleCountCreator      CycleCount[] @relation("CycleCountCreator")
  cycleCountApprover     CycleCount[] @relation("CycleCountApprover")
  cycleCountCounter      CycleCountItem[] @relation("CycleCountCounter")
  productionOrderCreator ProductionOrder[] @relation("ProductionOrderCreator")

  @@unique([companyId, userId])
}

/// Token-based email invitations. Works whether user exists or not.
model Invitation {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invitedEmail   String
  invitedById    String
  invitedBy      Profile   @relation("InvitedBy", fields: [invitedById], references: [id])
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  token          String    @unique @default(cuid())
  status         String    @default("pending") // pending | accepted | expired | revoked
  acceptedById   String?
  acceptedBy     Profile?  @relation("AcceptedBy", fields: [acceptedById], references: [id])
  acceptedAt     DateTime?
  expiresAt      DateTime  @default(now())
  message        String?
  metadata       String    @default("{}")
  createdAt      DateTime  @default(now())
}

/// Stores active workspace context per user.
model UserSetting {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompanyId   String?
  activeCompany     Company? @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull)
  activeOrgId       String?
  theme             String   @default("system") // light | dark | system
  language          String   @default("en")
  notificationPrefs String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Immutable append-only event log. Foundation for the KPI system.
model AuditLog {
  id             String   @id @default(cuid())
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  ipAddress      String?
  userAgent      String?
  oldValues      String?
  newValues      String?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([companyId, entityType, createdAt])
  @@index([companyId, createdAt])
}

/// Raw numeric events. Future KPI dashboards aggregate from this table.
model MetricEvent {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  metricKey    String
  numericValue Float
  currency     String?
  dimensions   String   @default("{}")
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([companyId, entityType, metricKey, recordedAt])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPRINT 3 — PRODUCT CATALOG SYSTEM
// 12 models: categories, brands, attributes, products, variants,
// images, bundles, selective access, company pricing, returned inventory.
// Multi-tenant isolation: org-level catalog + company-level pricing.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// Hierarchical categories at organization level (shared by all companies).
model OrgCategory {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         OrgCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       OrgCategory[] @relation("CategoryTree")
  name           String
  slug           String
  imageUrl       String?
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdById    String?
  createdBy      Employee? @relation("CategoryCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products       OrgProduct[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

/// Brands at organization level. e.g. LAMHA, Muzammil Collection.
model OrgBrand {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  logoUrl        String?
  isActive       Boolean  @default(true)
  createdById    String?
  createdBy      Employee? @relation("BrandCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products       OrgProduct[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

/// Attribute definitions used to build variants. e.g. Size, Color, Piece Type.
model OrgAttribute {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String   // "Size"
  displayName    String   // "Select Size"
  attributeType  String   @default("select") // select | color
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdById    String?
  createdBy      Employee? @relation("AttributeCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  values         OrgAttributeValue[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Values for each attribute. e.g. S, M, L / Red, Navy / Unstitched, Stitched.
model OrgAttributeValue {
  id             String   @id @default(cuid())
  attributeId    String
  attribute      OrgAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  value          String   // "Medium"
  displayValue   String   // "M"
  colorHex       String?  // only for color type
  skuCode        String?  // e.g. "M", "XXL", "RED" — used to build variant SKUs
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([attributeId, value])
  @@index([organizationId])
}

/// Master product record. Lives at org level. Created by one company,
/// can be promoted to org-wide or selective sharing.
model OrgProduct {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceCompanyId String
  sourceCompany   Company @relation(fields: [sourceCompanyId], references: [id])

  categoryId     String?
  category       OrgCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          OrgBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  title          String
  slug           String
  baseSku        String?  // manually entered by user, e.g. "FSES-10A". Nullable — falls back to slug.
  description    String?
  shortDescription String? @db.VarChar(500)

  productType    String   @default("variable") // simple | variable | bundle | service
  productScope   String   @default("private") // private | organization | selective | archived

  isStitchable   Boolean  @default(false)
  hasSizeVariants Boolean @default(false)
  stitchingBasePrice Decimal @default(0) @db.Decimal(12, 2)

  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)

  promotedAt     DateTime?
  promotedById   String?
  promotedBy     Employee? @relation("ProductPromoter", fields: [promotedById], references: [id])
  demotedAt      DateTime?
  demotedById    String?
  demotedBy      Employee? @relation("ProductDemoter", fields: [demotedById], references: [id])
  demotionReason String?

  createdById    String
  createdBy      Employee @relation("ProductCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants       OrgProductVariant[]
  images         OrgProductImage[]
  bundles        OrgProductBundle[] @relation("BundleProduct")
  selectiveAccess SelectiveProductAccess[]
  companySettings CompanyProductSetting[]

  @@unique([organizationId, slug])
  @@index([organizationId, productScope])
  @@index([sourceCompanyId])
}

/// Every unique sellable combination of a product. Shopify-compatible fields.
/// NOTE: attribute_values JSONB must never exceed 3 keys (Shopify limit).
model OrgProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        OrgProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  sku            String   @unique
  barcode        String?  @unique
  // JSONB: { "Piece Type": "Stitched", "Size": "M" } — max 3 keys
  attributeValues String  @default("{}")

  costPrice      Decimal  @default(0) @db.Decimal(12, 2)
  weightGrams    Int      @default(0)

  fulfillmentType String  @default("stock_based") // stock_based | made_to_order
  stitchingType  String?  // unstitched | stitched_basic | stitched_heavy | custom_order
  stitchingCharges Decimal @default(0) @db.Decimal(12, 2)
  productionDays Int      @default(0)

  isTaxable      Boolean  @default(true)
  requiresShipping Boolean @default(true)
  inventoryPolicy String  @default("deny") // deny | continue

  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)

  // Shopify sync fields
  shopifyVariantId      String? @unique
  shopifyInventoryItemId String?

  // Dimensions for courier/international
  dimensions      String  @default("{}") // { length_cm, width_cm, height_cm }

  // Sprint 6 — Inventory system columns
  trackInventory      Boolean @default(true) // FALSE for made_to_order until first return; one-way TRUE→never back to FALSE
  fabricSourceVariantId String? // self-reference: the stock_based variant fabric is drawn from for made_to_order production
  fabricSourceVariant  OrgProductVariant? @relation("FabricSource", fields: [fabricSourceVariantId], references: [id])
  fabricSourceFor      OrgProductVariant[] @relation("FabricSource")

  createdById     String?
  createdBy       Employee? @relation("VariantCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  images          OrgProductImage[]
  bundleComponents OrgProductBundle[] @relation("BundleComponent")
  companyPricing  CompanyVariantPricing[]
  returnedInventory ReturnedStitchedInventory[]
  fulfillmentCosts ProductFulfillmentCost[]
  inventoryPools  InventoryPool[]
  inventoryTransactions InventoryTransaction[]
  avgCostHistory  AvgCostHistory[]
  stockTransfers  StockTransfer[]
  stockLossRecords StockLossRecord[]
  cycleCountItems CycleCountItem[]
  productionOrdersStitched ProductionOrder[] @relation("StitchedVariantProduction")
  productionOrdersFabric ProductionOrder[] @relation("FabricVariantProduction")
  supplierReturns SupplierReturn[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseOrderReceiptItems PurchaseOrderReceiptItem[]

  @@index([productId])
  @@index([organizationId, fulfillmentType])
}

/// Images stored in Supabase Storage, shared across all subscribing companies.
model OrgProductImage {
  id             String   @id @default(cuid())
  productId      String
  product        OrgProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  variantId      String?
  variant        OrgProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  storagePath    String
  publicUrl      String
  displayOrder   Int      @default(0)
  isPrimary      Boolean  @default(false)

  uploadedById   String?
  uploadedBy     Employee? @relation("ImageUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([productId])
}

/// For bundle-type products. Defines component variants and quantities.
model OrgProductBundle {
  id             String   @id @default(cuid())
  bundleProductId String
  bundleProduct   OrgProduct @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentVariantId String
  componentVariant  OrgProductVariant @relation("BundleComponent", fields: [componentVariantId], references: [id])
  quantity       Int      @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([bundleProductId, componentVariantId])
}

/// When product_scope = 'selective', controls which companies can access it.
model SelectiveProductAccess {
  id             String   @id @default(cuid())
  orgProductId   String
  orgProduct     OrgProduct @relation(fields: [orgProductId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  grantedById    String?
  grantedBy      Employee? @relation("SelectiveAccessGranter", fields: [grantedById], references: [id])
  grantedAt      DateTime @default(now())

  @@unique([orgProductId, companyId])
}

/// Per-company pricing and activation for a shared org product.
model CompanyProductSetting {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orgProductId   String
  orgProduct     OrgProduct @relation(fields: [orgProductId], references: [id], onDelete: Cascade)

  isActive       Boolean  @default(true)
  subscriptionStatus String @default("active") // active | paused | revoked

  subscribedAt   DateTime @default(now())
  subscribedById String?
  subscribedBy   Employee? @relation("SubscriptionCreator", fields: [subscribedById], references: [id])
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      Employee? @relation("SubscriptionRevoker", fields: [revokedById], references: [id])
  revokeReason   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, orgProductId])
  @@index([companyId])
}

/// Per-variant selling price set independently by each company.
model CompanyVariantPricing {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  salePrice      Decimal  @db.Decimal(12, 2)
  comparePrice   Decimal? @db.Decimal(12, 2)

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, orgVariantId])
  @@index([companyId])
}

/// Special pool for made-to-order items returned in sellable condition.
/// This is the ONLY stock a made_to_order variant ever holds.
model ReturnedStitchedInventory {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id], onDelete: Cascade)

  quantity       Int      @default(1)
  condition      String   // perfect | good | open_box | damaged
  totalCost      Decimal  @db.Decimal(12, 2)
  suggestedResalePrice Decimal? @db.Decimal(12, 2)

  originalOrderReference String?
  returnReason   String?
  status         String   @default("available") // available | sold | written_off

  photos         String   @default("[]") // JSON array of URLs
  notes          String?

  receivedById   String?
  receivedBy     Employee? @relation("ReturnedItemReceiver", fields: [receivedById], references: [id])
  receivedAt     DateTime @default(now())

  soldAt         DateTime?
  soldOrderReference String?

  writtenOffAt   DateTime?
  writtenOffById String?
  writtenOffBy   Employee? @relation("ReturnedItemWriteOff", fields: [writtenOffById], references: [id])
  writeOffReason String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, orgVariantId, status])
  @@index([companyId, status])
}

/// Tracks cost components for made_to_order variants in production.
model ProductFulfillmentCost {
  id             String   @id @default(cuid())
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String?
  employee       Employee? @relation("FulfillmentCostLogger", fields: [employeeId], references: [id])

  orderReference String?
  fabricCost     Decimal  @default(0) @db.Decimal(12, 2)
  stitchingCost  Decimal  @default(0) @db.Decimal(12, 2)
  embroideryCost Decimal  @default(0) @db.Decimal(12, 2)
  otherCost      Decimal  @default(0) @db.Decimal(12, 2)
  totalProductionCost Decimal @default(0) @db.Decimal(12, 2)
  salePrice      Decimal? @db.Decimal(12, 2)

  status         String   @default("in_production") // in_production | dispatched | delivered | returned | written_off
  tailorName     String?
  notes          String?
  metadata       String   @default("{}")

  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  returnedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, orgVariantId, status])
  @@index([orderReference])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SPRINT 6 — INVENTORY, WAREHOUSE, PURCHASE ORDER, SUPPLIER SYSTEM
// 11 models: locations, suppliers, pools, transactions, avg_cost_history,
// transfers, purchase_orders (+items+receipts), supplier_returns,
// stock_loss, cycle_counts, production_orders.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// Warehouse/dispatch/retail locations. company_id NULL = org-level shared.
model InventoryLocation {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?  // NULL = org-level shared location
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name           String
  locationType   String   @default("warehouse") // warehouse | dispatch_hub | retail_store | transit | damaged_hold
  address        String?  // JSONB: { street, city, province, postal_code, country }
  city           String   @default("Lahore")
  province       String   @default("Punjab")
  countryCode    String   @default("PK")
  postalCode     String?
  contactPerson  String?
  contactPhone   String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)

  createdById    String?
  createdBy      Employee? @relation("LocationCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventoryPools       InventoryPool[]
  inventoryTransactions InventoryTransaction[]
  avgCostHistory       AvgCostHistory[]
  stockTransfersFrom   StockTransfer[] @relation("TransferFromLocation")
  stockTransfersTo     StockTransfer[] @relation("TransferToLocation")
  purchaseOrders       PurchaseOrder[]
  supplierReturns      SupplierReturn[]
  stockLossRecords     StockLossRecord[]
  cycleCounts          CycleCount[]
  productionOrders     ProductionOrder[]

  @@index([organizationId])
  @@index([companyId])
}

/// Suppliers. company_id NULL = org-level shared supplier.
model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?  // NULL = shared across org
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?  // JSONB

  paymentTerms   String   @default("immediate") // immediate | net_15 | net_30 | net_45 | net_60
  creditBalance  Decimal  @default(0) @db.Decimal(12, 2) // running credit owed BY supplier TO us
  isActive       Boolean  @default(true)

  createdById    String?
  createdBy      Employee? @relation("SupplierCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  supplierReturns SupplierReturn[]

  @@index([organizationId])
  @@index([companyId])
}

/// THE single source of truth for stock levels. One row per variant per location.
model InventoryPool {
  id             String   @id @default(cuid())
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id], onDelete: Cascade)
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  onHand         Int      @default(0)
  reserved       Int      @default(0)
  // available = onHand - reserved (computed in application layer)
  incoming       Int      @default(0) // sum of undelivered PO quantities

  avgCost        Decimal  @default(0) @db.Decimal(12, 4)
  // totalStockValue = onHand * avgCost (computed in application layer)

  reorderPoint   Int      @default(0)
  reorderQuantity Int     @default(0)

  lastReceivedAt DateTime?
  lastSoldAt     DateTime?
  lastCountedAt  DateTime?

  updatedAt      DateTime @updatedAt

  @@unique([orgVariantId, locationId])
  @@index([organizationId, orgVariantId])
  @@index([locationId])
}

/// Append-only ledger. Never update or delete rows.
model InventoryTransaction {
  id             String   @id @default(cuid())
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id])
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  companyId      String?  // NULL for org-level events
  company        Company?  @relation(fields: [companyId], references: [id])
  employeeId     String?
  employee       Employee? @relation("InventoryTxnEmployee", fields: [employeeId], references: [id])

  transactionType String  // opening_stock | purchase_received | sale_dispatched | order_reserved | order_unreserved | return_resellable | return_damaged | return_stitched_received | transfer_out | transfer_in | cycle_count_adjust | damage_writeoff | theft_writeoff | missing_writeoff | transit_loss | supplier_return | fabric_consumed_for_stitching

  quantity       Int      // positive = in, negative = out
  costPerUnit    Decimal  @default(0) @db.Decimal(12, 4)
  // totalCostValue = ABS(quantity) * costPerUnit (computed in app)

  avgCostBefore  Decimal? @db.Decimal(12, 4)
  avgCostAfter   Decimal? @db.Decimal(12, 4)

  referenceType  String?  // order | purchase_order | transfer | cycle_count | stock_loss | manual | opening | production_order | supplier_return
  referenceId    String?

  notes          String?
  metadata       String   @default("{}")

  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  avgCostHistory AvgCostHistory[]
  purchaseOrderReceiptItems PurchaseOrderReceiptItem[]
  supplierReturns SupplierReturn[]
  stockLossRecords StockLossRecord[]
  cycleCountItems CycleCountItem[]
  productionOrdersFabric ProductionOrder[]

  @@index([orgVariantId, recordedAt])
  @@index([companyId, transactionType, recordedAt])
  @@index([organizationId, transactionType, recordedAt])
  @@index([referenceType, referenceId])
}

/// Audit trail of every average-cost change.
model AvgCostHistory {
  id             String   @id @default(cuid())
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id])
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  avgCostBefore  Decimal  @db.Decimal(12, 4)
  avgCostAfter   Decimal  @db.Decimal(12, 4)
  triggeredByTxnId String
  triggeredByTxn InventoryTransaction @relation(fields: [triggeredByTxnId], references: [id])
  triggerReason  String?
  createdAt      DateTime @default(now())

  @@index([orgVariantId])
}

/// Stock transfer between locations. Logistics cost tracked separately from WAC.
model StockTransfer {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id])

  fromLocationId String
  fromLocation   InventoryLocation @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     InventoryLocation @relation("TransferToLocation", fields: [toLocationId], references: [id])

  quantity       Int      // CHECK > 0 enforced in app
  costPerUnitAtTransfer Decimal @db.Decimal(12, 4) // sending location's avg_cost at transfer time
  logisticsCost  Decimal  @default(0) @db.Decimal(12, 2) // separate expense, NEVER merged into WAC

  status         String   @default("completed") // completed | in_transit | cancelled
  notes          String?
  initiatedById  String?
  initiatedBy    Employee? @relation("TransferInitiator", fields: [initiatedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([orgVariantId])
}

/// Purchase order header.
model PurchaseOrder {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])

  poNumber       String   @unique // PO-{year}-{sequence}
  status         String   @default("draft") // draft | ordered | partially_received | received | cancelled

  orderDate      DateTime @default(now())
  expectedDeliveryDate DateTime?
  deliveryLocationId String
  deliveryLocation InventoryLocation @relation(fields: [deliveryLocationId], references: [id])

  advancePayment Decimal  @default(0) @db.Decimal(12, 2)
  paymentMethod  String?
  notes          String?

  createdById    String
  createdBy      Employee @relation("POCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cancelledAt    DateTime?
  cancelledById  String?
  cancelledBy    Employee? @relation("POCanceller", fields: [cancelledById], references: [id])
  cancellationReason String?

  items          PurchaseOrderItem[]
  receipts       PurchaseOrderReceipt[]
  supplierReturns SupplierReturn[]

  @@index([companyId, status])
  @@index([organizationId])
}

/// Line items on a purchase order.
model PurchaseOrderItem {
  id             String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  orderedQuantity Int     // CHECK > 0
  receivedQuantity Int    @default(0)
  costPerUnit     Decimal @db.Decimal(12, 4)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  receiptItems   PurchaseOrderReceiptItem[]

  @@index([purchaseOrderId])
}

/// Each individual receiving event against a PO (supports partial deliveries).
model PurchaseOrderReceipt {
  id             String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  receivedAt     DateTime @default(now())
  receivedById   String
  receivedBy     Employee @relation("POReceiver", fields: [receivedById], references: [id])
  notes          String?
  createdAt      DateTime @default(now())

  items          PurchaseOrderReceiptItem[]

  @@index([purchaseOrderId])
}

/// Line items within one receiving event — actual quantity and cost that arrived.
model PurchaseOrderReceiptItem {
  id             String   @id @default(cuid())
  purchaseOrderReceiptId String
  purchaseOrderReceipt PurchaseOrderReceipt @relation(fields: [purchaseOrderReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id])

  receivedQuantity Int    // CHECK >= 0
  actualCostPerUnit Decimal @db.Decimal(12, 4)
  shortageQuantity Int    @default(0)
  shortageReason  String?

  inventoryTxnId String?
  inventoryTxn   InventoryTransaction? @relation(fields: [inventoryTxnId], references: [id])

  createdAt      DateTime @default(now())
}

/// Supplier returns — stock sent back to supplier.
model SupplierReturn {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  purchaseOrderId String?
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id])
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id])

  quantity       Int      // CHECK > 0
  costPerUnit    Decimal  @db.Decimal(12, 4)
  // totalValue = quantity * costPerUnit (computed in app)

  reason         String   // defective | wrong_item | quality_issue | excess_quantity | other
  status         String   @default("pending") // pending | sent_to_supplier | refunded | replaced | credit_note | disputed | rejected
  resolutionType String?  // refund | replacement | credit_note
  resolutionAmount Decimal? @db.Decimal(12, 2)
  replacementPoId String?

  photos         String   @default("[]") // JSON array
  notes          String?

  inventoryTxnId String?
  inventoryTxn   InventoryTransaction? @relation(fields: [inventoryTxnId], references: [id])

  reportedById   String
  reportedBy     Employee @relation("SupplierReturnReporter", fields: [reportedById], references: [id])
  resolvedById   String?
  resolvedBy     Employee? @relation("SupplierReturnResolver", fields: [resolvedById], references: [id])
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  @@index([companyId, status])
  @@index([supplierId])
}

/// Stock loss records — damaged/theft/missing/transit_loss.
model StockLossRecord {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id])
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id])

  lossType       String   // damaged | theft | missing | transit_loss
  subType        String?  // confirmed | suspected | admin_error | manufacturing
  damageType     String?  // water_moisture | physical_impact | manufacturing_defect | transit_damage | storage_damage | other

  quantity       Int
  costPerUnit    Decimal  @db.Decimal(12, 4)
  // totalLossValue = quantity * costPerUnit (computed in app)

  investigationStatus String @default("none") // none | open | closed
  resolution     String?  // written_off | recovered | error_corrected | claim_accepted | claim_rejected
  responsibleParty String? // warehouse | courier | customer | employee | unknown
  policeReportRef String?
  insuranceClaimRef String?
  insuranceRecovered Decimal @default(0) @db.Decimal(12, 2)
  courierClaimRef String?
  courierClaimStatus String? // not_filed | filed | accepted | rejected
  courierRecovered Decimal @default(0) @db.Decimal(12, 2)

  evidenceUrls   String   @default("[]") // JSON array
  notes          String?

  reportedById   String
  reportedBy     Employee @relation("StockLossReporter", fields: [reportedById], references: [id])
  approvedById   String?
  approvedBy     Employee? @relation("StockLossApprover", fields: [approvedById], references: [id])
  resolvedById   String?
  resolvedBy     Employee? @relation("StockLossResolver", fields: [resolvedById], references: [id])

  inventoryTxnId String?
  inventoryTxn   InventoryTransaction? @relation(fields: [inventoryTxnId], references: [id])
  orderReferenceId String? // will reference orders table in future sprint

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  resolvedAt     DateTime?

  @@index([companyId, lossType])
  @@index([orgVariantId])
}

/// Cycle count header.
model CycleCount {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id])

  countName      String
  countType      String   @default("full") // full | partial | spot
  status         String   @default("scheduled") // scheduled | in_progress | pending_review | approved | cancelled

  scheduledAt    DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  approvedAt     DateTime?

  assignedToId   String?
  assignedTo     Employee? @relation("CycleCountAssignee", fields: [assignedToId], references: [id])
  createdById    String
  createdBy      Employee @relation("CycleCountCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     Employee? @relation("CycleCountApprover", fields: [approvedById], references: [id])

  notes          String?
  totalDiscrepancies Int  @default(0)
  totalVarianceValue Decimal @default(0) @db.Decimal(16, 2)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items          CycleCountItem[]

  @@index([companyId, status])
}

/// Individual items in a cycle count.
model CycleCountItem {
  id             String   @id @default(cuid())
  cycleCountId   String
  cycleCount     CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  orgVariantId   String
  orgVariant     OrgProductVariant @relation(fields: [orgVariantId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  systemQuantity Int
  countedQuantity Int?
  // discrepancy = countedQuantity - systemQuantity (computed in app)
  discrepancyValue Decimal? @db.Decimal(16, 2)

  discrepancyReason String? // recording_error | theft_suspected | damage_not_recorded | transfer_not_recorded | unknown | no_discrepancy

  adjustmentApproved Boolean @default(false)
  inventoryTxnId String?
  inventoryTxn   InventoryTransaction? @relation(fields: [inventoryTxnId], references: [id])

  countedById    String?
  countedBy      Employee? @relation("CycleCountCounter", fields: [countedById], references: [id])
  countedAt      DateTime?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([cycleCountId])
}

/// Production order for made-to-order fabric tracking.
model ProductionOrder {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])

  stitchedVariantId String
  stitchedVariant OrgProductVariant @relation("StitchedVariantProduction", fields: [stitchedVariantId], references: [id])
  fabricVariantId String
  fabricVariant   OrgProductVariant @relation("FabricVariantProduction", fields: [fabricVariantId], references: [id])
  fabricLocationId String
  fabricLocation  InventoryLocation @relation(fields: [fabricLocationId], references: [id])

  quantity       Int      @default(1)

  status         String   @default("pending") // pending | fabric_reserved | in_production | completed | dispatched | cancelled

  stitchingCost  Decimal  @default(0) @db.Decimal(12, 2)
  fabricCost     Decimal  @default(0) @db.Decimal(12, 2)
  // totalCost = stitchingCost + fabricCost (computed in app)

  assignedTailor String?
  estimatedCompletionDate DateTime?
  actualCompletionDate    DateTime?

  referenceType  String   @default("order")
  referenceId    String?  // will link to orders table in future sprint

  fabricTxnId    String?
  fabricTxn      InventoryTransaction? @relation(fields: [fabricTxnId], references: [id])

  createdById    String
  createdBy      Employee @relation("ProductionOrderCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cancelledAt    DateTime?
  cancellationReason String?

  @@index([companyId, status])
  @@index([stitchedVariantId])
}
